# Public site origin — used for canonical URLs, sitemap, robots, OG tags and
# the shadcn registry install commands. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://velora.colorlib.com

# Public GitHub repo URL — used by the "Star on GitHub" links.
NEXT_PUBLIC_GITHUB_URL=https://github.com/ColorlibHQ/velora-ui

# Registry homepage used by scripts/build-registry.mjs when generating
# registry.json and llms.txt (defaults to https://velora.colorlib.com).
REGISTRY_HOMEPAGE=https://velora.colorlib.com
